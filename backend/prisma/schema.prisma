generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets      Pet[]
  clinics   Clinic[]
}

model Pet {
  id        Int      @id @default(autoincrement())
  name      String
  species   String
  breed     String?
  sex       String?
  birthDate DateTime?
  weight    Float?
  photoUrl  String?

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  feedings              Feeding[]
  medications           Medication[]
  vaccinations          Vaccination[]
  veterinaryAppointments VeterinaryAppointment[]
  activities             Activity[]
  groomings              Grooming[]
  reminders              Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feeding {
  id        Int      @id @default(autoincrement())
  date      DateTime
  time      String
  type      String
  quantity  String

  petId     Int
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Medication {
  id          Int      @id @default(autoincrement())
  name        String
  dosage      String
  frequency   String
  startDate   DateTime
  endDate     DateTime?
  notes       String?

  petId       Int
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vaccination {
  id             Int      @id @default(autoincrement())
  vaccineName    String
  applicationDate DateTime
  nextDoseDate   DateTime?
  responsible   String?

  petId          Int
  pet            Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
}

model VeterinaryAppointment {
  id          Int      @id @default(autoincrement())
  date        DateTime
  clinic      String?
  veterinarian String?
  diagnosis   String?
  notes       String?

  petId       Int
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Activity {
  id          Int      @id @default(autoincrement())
  date        DateTime
  type        String
  duration    Int?
  notes       String?

  petId       Int
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Grooming {
  id          Int      @id @default(autoincrement())
  date        DateTime
  type        String
  notes       String?

  petId       Int
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
}

model Reminder {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  date        DateTime
  type        String
  completed   Boolean  @default(false)

  petId       Int
  pet         Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Clinic {
  id        Int      @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  rating    Float?

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          Int      @id @default(autoincrement())
  name        String
  type        String
  address     String?
  phone       String?
  description String?
  rating      Float?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}